{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "NATS": "Warning"
    }
  },
  "Nats": {
    "Url": "nats://127.0.0.1:4222",
    "Subject": "lp.>",
    "ClientName": "linepulse-core",
    "ReconnectSeconds": 1
  },
  "Storage": {
    "Provider": "Sqlite",
    "SqlitePath": "data/linepulse.db",
    "SqlServerConnectionString": ""
  },
  "Ingest": {
    "WatermarkSeconds": 30,
    "MicroStopThresholdSeconds": 120,
    "DedupCacheSize": 50000,
    "BucketFlushMs": 500
  },
  "Spc": {
    "WindowSize": 200,
    "MinSamples": 25,
    "WarnCpk": 1.33,
    "AlarmCpk": 1.0,
    "ProjectionHorizonParts": 1000
  },
  "Shifts": {
    "StartHours": [
      6,
      14,
      22
    ],
    "Labels": [
      "A",
      "B",
      "C"
    ],
    "SiteTimeZones": {
      "IZM": "Europe/Istanbul",
      "NIS": "Europe/Belgrade"
    },
    "DefaultTimeZone": "UTC"
  },
  "Live": {
    "KpiTickSeconds": 5,
    "HeartbeatSeconds": 15,
    "ClientQueueCapacity": 64
  }
}
