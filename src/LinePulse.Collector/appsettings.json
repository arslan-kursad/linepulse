{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Opc.Ua": "Warning",
      "NATS": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Collector": {
    "OpcUa": {
      "Enabled": true,
      "EndpointUrl": "opc.tcp://127.0.0.1:4840/linepulse/server/",
      "RootObjectName": "LinePulse",
      "ApplicationName": "LinePulse Collector",
      "PkiRoot": "data/pki",
      "PublishingIntervalMs": 250,
      "SamplingIntervalMs": 100,
      "KeepAliveIntervalMs": 5000,
      "SessionTimeoutMs": 60000,
      "SampleEmitIntervalMs": 250,
      "SubscriptionStallTimeoutMs": 15000
    },
    "Mqtt": {
      "Enabled": true,
      "Host": "127.0.0.1",
      "Port": 1883,
      "ClientId": "linepulse-collector",
      "TopicFilter": "linepulse/+/+/eol/test",
      "KeepAliveSeconds": 30,
      "SessionExpiryIntervalSeconds": 3600
    },
    "Nats": {
      "Url": "nats://127.0.0.1:4222",
      "ConnectionName": "linepulse-collector",
      "BatchSize": 200,
      "IdleDelayMs": 100,
      "ConfirmTimeoutMs": 5000
    },
    "Spool": {
      "Path": "data/spool.db",
      "ReportIntervalSeconds": 10,
      "PruneIntervalSeconds": 300
    }
  }
}
